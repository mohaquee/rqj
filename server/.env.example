# ─── Postgres connection ───────────────────────────────────
DATABASE_URL=postgresql://rqj_user:rqj_password@localhost:5432/rqj_db

# ─── Server config ─────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── Auth — REGENERATE THIS FOR PRODUCTION ─────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING_BEFORE_DEPLOYING
JWT_EXPIRES_IN=12h

# ─── CORS — comma-separated list of allowed origins ────────
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
